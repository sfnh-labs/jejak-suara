# Cloudflare Workers build output (wrangler.jsonc IS tracked)
web/.open-next/
web/.wrangler/
web/cloudflare-env.d.ts
web/.dev.vars

# Local dev Postgres (PGlite data directory)
web/.pglite/

# Environment
.env
.env.local
.env.production

# Dependencies
node_modules/
web/node_modules/

# Next.js
web/.next/
web/out/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Database (dev SQLite stays local)
jejak.db
smoke*.db

# Design source (Claude design exports + zips) — kept local, not versioned
.design/

# Editor
.claude/settings.local.json

# Build/log artifacts
scripts/*.log
web/tsconfig.tsbuildinfo

# Database backups taken by the repair scripts (scripts/prune_orphan_events.py,
# scripts/mask_stored_authors.py) before they rewrite rows. Local safety nets,
# not history.
jejak.db.bak.*
scripts/jejak.db.bak.*
jejak.db-journal

# Runtime state of the scheduled pipeline run.
scripts/.publish_local.lock
scripts/*.log.prev
